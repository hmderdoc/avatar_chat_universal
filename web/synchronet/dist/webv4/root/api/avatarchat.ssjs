    var viewer = currentViewer();
    var reply;
    try {
      reply = run(cfg, viewer, param("action"));
    } catch (e) {
      log(LOG_ERR, "avatarchat.ssjs: " + e);
      reply = { error: "internal error" };
    }
    write(JSON.stringify(reply));
  })();
})();
