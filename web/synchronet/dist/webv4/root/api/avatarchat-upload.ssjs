      return respond({ ok: false, error: "POST required" });
    if (!writeAllowed(viewer.number)) {
      http_reply.status = "403 Forbidden";
      return respond({ ok: false, error: "stale page: reload it" });
    }
    var up = new Uploads(cfg, viewer);
    if (!ensureDir(up.stage) || !ensureDir(up.media))
      return respond({ ok: false, error: "upload storage unavailable" });
    try {
      switch (param("action")) {
        case "begin":
          return respond(up.begin());
        case "chunk":
          return respond(up.chunk());
        case "finish":
          return respond(up.finish());
        case "abort":
          return respond(up.abort());
      }
      respond({ ok: false, error: "unknown action" });
    } catch (e) {
      log(LOG_ERR, "avatarchat-upload.ssjs: " + e);
      respond({ ok: false, error: "internal error" });
    }
  })();
})();
