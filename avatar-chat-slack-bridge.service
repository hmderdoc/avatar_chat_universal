[Unit]
Description=Avatar Chat Slack Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sbbs
Group=sbbs
WorkingDirectory=/sbbs/xtrn/avatar_chat_universal
ExecStart=/sbbs/xtrn/avatar_chat_universal/avatar_chat_slack_bridge -config /sbbs/xtrn/avatar_chat_universal/slack_bridge.ini
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
